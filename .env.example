# Public demo works with no provider credentials. Keep real events disabled until
# an isolated cloud backend passes the acceptance checklist in README.md.
CANDIDS_PILOT_ENABLED=false
CANDIDS_APP_URL=https://candids.tinotech.co.za
# Optional public asset origin while a custom domain is awaiting DNS.
CANDIDS_ASSET_URL=https://candids-tinotech.vercel.app

# Next server only: never prefix these with NEXT_PUBLIC_. Use two independent
# cryptographically random values of at least 32 characters.
CANDIDS_CONVEX_URL=
CANDIDS_BRIDGE_SECRET=
CANDIDS_COOKIE_SECRET=

# Local anonymous development only. Ignored in production.
CANDIDS_ALLOW_LOCAL=false
# Reviewed private Docker deployment only; accepts exactly candids-convex:3210.
CANDIDS_SELF_HOSTED=false
# CONVEX_DEPLOYMENT is selected by the official Convex CLI in .env.local.
# A cloud CONVEX_DEPLOY_KEY belongs in the private deployment environment only.
# Backend-only, disabled by default; enable solely during a reviewed maintenance
# window on the NEW isolated Convex deployment. See STORAGE_RUNBOOK.md.
# CANDIDS_STORAGE_MAINTENANCE_ENABLED=false
